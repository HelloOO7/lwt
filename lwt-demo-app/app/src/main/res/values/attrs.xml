<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="EdgeToEdgeAttrs">
        <attr name="marginWindowInsets" format="flags">
            <flag name="left" value="1"/>
            <flag name="top" value="2"/>
            <flag name="right" value="4"/>
            <flag name="bottom" value="8"/>
            <flag name="start" value="17"/>
            <flag name="end" value="20"/>
            <flag name="horizontal" value="5"/>
            <flag name="vertical" value="10"/>
            <flag name="all" value="15"/>
        </attr>
        <attr name="paddingWindowInsets" format="flags">
            <flag name="left" value="1"/>
            <flag name="top" value="2"/>
            <flag name="right" value="4"/>
            <flag name="bottom" value="8"/>
            <flag name="start" value="17"/>
            <flag name="end" value="20"/>
            <flag name="horizontal" value="5"/>
            <flag name="vertical" value="10"/>
            <flag name="all" value="15"/>
        </attr>
        <attr name="widthWindowInsets" format="flags">
            <flag name="left" value="1"/>
            <flag name="right" value="4"/>
            <flag name="start" value="17"/>
            <flag name="end" value="20"/>
            <flag name="all" value="5"/>
        </attr>
        <attr name="heightWindowInsets" format="flags">
            <flag name="top" value="2"/>
            <flag name="bottom" value="8"/>
            <flag name="all" value="10"/>
        </attr>
    </declare-styleable>

    <declare-styleable name="ConnectionRouteNode">
        <attr name="pathWidth" format="dimension"/>
        <attr name="nodeDiameter" format="dimension"/>
        <attr name="nodeMargin" format="dimension"/>
        <attr name="nodeType" format="enum">
            <enum name="segment_start" value="0"/>
            <enum name="segment_end" value="1"/>
            <enum name="start" value="2"/>
            <enum name="finish" value="3"/>
            <enum name="normal" value="4"/>
        </attr>
        <attr name="showNode" format="boolean"/>
        <attr name="pathTypeIn" format="enum">
            <enum name="normal" value="0"/>
            <enum name="selected" value="1"/>
            <enum name="error" value="2"/>
        </attr>
        <attr name="showPathIn" format="boolean"/>
        <attr name="pathTypeOut" format="enum">
            <enum name="normal" value="0"/>
            <enum name="selected" value="1"/>
            <enum name="error" value="2"/>
        </attr>
        <attr name="showPathOut" format="boolean"/>
        <attr name="pathColor" format="color"/>
    </declare-styleable>

    <attr name="colorPrimaryMuted" />
</resources>