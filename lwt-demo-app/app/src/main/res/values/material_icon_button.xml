<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Ext.MaterialComponents.IconButton" parent="Widget.MaterialComponents.Button">
        <item name="iconPadding">0dp</item>
        <item name="iconTint">?attr/colorOnPrimary</item>
        <item name="iconGravity">textStart</item>
        <item name="android:minWidth">0dp</item>
    </style>
    <style name="Ext.MaterialComponents.IconButton.Unelevated" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="iconPadding">0dp</item>
        <item name="iconTint">?attr/colorOnPrimary</item>
        <item name="iconGravity">textStart</item>
        <item name="android:minWidth">0dp</item>
    </style>
    <style name="Ext.MaterialComponents.IconButton.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="iconPadding">0dp</item>
        <item name="iconTint">?attr/colorOnSurface</item>
        <item name="iconGravity">textStart</item>
        <item name="android:minWidth">0dp</item>
        <item name="strokeColor">@color/mtrl_btn_stroke_color_selector</item>
    </style>
    <style name="Ext.MaterialComponents.IconButton.Plain" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="iconPadding">0dp</item>
        <item name="iconTint">?attr/colorOnSurface</item>
        <item name="iconGravity">textStart</item>
        <item name="android:minWidth">0dp</item>
        <item name="strokeColor">@color/mtrl_btn_stroke_color_selector</item>
        <item name="android:background">?android:selectableItemBackgroundBorderless</item>
    </style>
</resources>