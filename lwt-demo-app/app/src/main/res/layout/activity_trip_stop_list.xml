<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    app:paddingWindowInsets="top"
    android:clipChildren="false">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:marginWindowInsets="horizontal"
        android:layout_marginTop="@dimen/activity_vertical_margin">

        <!-- LayoutInflater hooks can not work with include tags, so we have to wrap it  -->

        <include
            android:id="@+id/tripInfoHeader"
            layout="@layout/device_list_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/activity_horizontal_margin" />
    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <cz.spojenka.android.ui.view.ConnectionRouteView
            android:id="@+id/crvRoute"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/section_margin_normal"
            android:paddingBottom="@dimen/activity_vertical_margin"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:paddingWindowInsets="bottom"
            android:clipToPadding="false"
            tools:listitem="@layout/connection_route_point" />
    </FrameLayout>
</LinearLayout>