<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <cz.spojenka.android.ui.view.ConnectionRouteNode
        android:id="@+id/mainRouteNode"
        android:layout_width="@dimen/journey_item_route_width"
        android:layout_height="0dp"
        android:layout_marginBottom="-4dp"
        app:layout_constraintBottom_toBottomOf="@+id/tvStationTimeLayoutAnchor"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:pathTypeIn="selected"
        app:pathTypeOut="selected"/>

    <TextView
        android:id="@+id/tvStationTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@id/tvStationTimeLayoutAnchor"
        app:layout_constraintTop_toTopOf="@id/tvStationTimeLayoutAnchor"
        tools:text="12:34" />

    <TextView
        android:id="@+id/tvStationTimeLayoutAnchor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/item_margin_normal"
        android:layout_marginTop="4dp"
        android:textStyle="bold"
        android:visibility="invisible"
        app:layout_constraintStart_toEndOf="@+id/mainRouteNode"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="12:34" />

    <cz.spojenka.android.ui.view.ConnectionRouteNode
        android:id="@+id/extRouteNode"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/mainRouteNode"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mainRouteNode"
        app:showNode="false"
        app:pathTypeIn="selected"
        app:pathTypeOut="selected"/>

    <com.google.android.flexbox.FlexboxLayout
        android:id="@+id/stationInfoContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:flexDirection="row"
        app:flexWrap="wrap"
        app:alignItems="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tvStationTime"
        app:layout_constraintTop_toTopOf="@+id/tvStationTime"
        app:showDividerVertical="middle"
        app:showDividerHorizontal="middle"
        android:layout_marginStart="8dp"
        app:layout_goneMarginStart="0dp">

        <TextView
            android:id="@+id/tvStationName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Chlebounová Lhota" />

        <TextView
            android:id="@+id/tvTariffZone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/spanish_red"
            tools:text="4" />

    </com.google.android.flexbox.FlexboxLayout>

    <LinearLayout
        android:id="@+id/detailsContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/stationInfoContainer"
        app:layout_constraintTop_toBottomOf="@+id/stationInfoContainer"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>