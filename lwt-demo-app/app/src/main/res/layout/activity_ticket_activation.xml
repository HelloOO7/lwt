<?xml version="1.0" encoding="utf-8"?>
<cz.spojenka.android.ui.helpers.CoordinatorLayoutFix xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/svScroller"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:paddingWindowInsets="vertical"
        android:paddingVertical="@dimen/activity_vertical_margin">

        <LinearLayout
            android:id="@+id/llContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipChildren="false"
            android:paddingBottom="@dimen/fab_top_offset"
            android:animateLayoutChanges="true">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/activity_horizontal_margin"
                android:text="@string/ticket_activation_title"
                android:textSize="@dimen/text_title_l"
                app:paddingWindowInsets="horizontal" />

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/activity_horizontal_margin"
                app:marginWindowInsets="horizontal"
                android:layout_marginTop="@dimen/item_margin_normal"/>

            <LinearLayout
                android:id="@+id/llZoneChoiceType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/activity_horizontal_margin"
                android:paddingVertical="@dimen/section_margin_normal"
                android:foreground="?android:attr/selectableItemBackground"
                app:paddingWindowInsets="horizontal">

                <TextView
                    android:id="@+id/tvZoneChoiceTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ticket_activation_zone_choice_title"
                    android:textSize="@dimen/text_title_s"
                    app:drawableEndCompat="@drawable/ic_chevron_right_24px" />

                <TextView
                    android:id="@+id/tvZoneChoiceSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_margin_small"
                    android:text="@string/ticket_activation_zone_choice_summary_auto" />

            </LinearLayout>

            <FrameLayout
                android:id="@+id/tripChoiceSubscreens"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:paddingWindowInsets="horizontal"
                android:clipToPadding="false"
                android:clipChildren="false">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvDeviceList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    android:clipToPadding="false"
                    android:paddingHorizontal="@dimen/activity_horizontal_margin"
                    android:visibility="visible"
                    tools:listitem="@layout/device_list_item"
                    tools:itemCount="3" />

                <include
                    android:id="@+id/selectedDeviceView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/activity_horizontal_margin"
                    android:visibility="gone"
                    layout="@layout/device_list_item" />

            </FrameLayout>

            <androidx.cardview.widget.CardView
                android:id="@+id/cvActivationStopCard"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="@dimen/item_margin_normal"
                android:layout_marginHorizontal="@dimen/activity_horizontal_margin"
                app:marginWindowInsets="horizontal">

                <include
                    android:id="@+id/activationStop"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    layout="@layout/connection_route_point" />
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:id="@+id/llActivationTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/activity_horizontal_margin"
                android:paddingVertical="@dimen/section_margin_normal"
                android:foreground="?android:attr/selectableItemBackground"
                app:paddingWindowInsets="horizontal">

                <TextView
                    android:id="@+id/tvActivationTimeTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ticket_activation_activation_time_title"
                    android:textSize="@dimen/text_title_s"
                    app:drawableEndCompat="@drawable/ic_chevron_right_24px" />

                <TextView
                    android:id="@+id/tvActivationTimeSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_margin_small"
                    android:text="@string/ticket_activation_activation_time_summary_default" />

            </LinearLayout>

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/activity_horizontal_margin"
                app:marginWindowInsets="horizontal"
                android:layout_marginTop="@dimen/item_margin_normal"/>

            <TextView
                android:id="@+id/tvActivationSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/activity_horizontal_margin"
                android:paddingVertical="@dimen/section_margin_normal"
                app:marginWindowInsets="horizontal"
                tools:text="Ticket will activate at X:XX for zones 1,2,3,4" />
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabConfirm"
        style="@style/Widget.MaterialComponents.ExtendedFloatingActionButton"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/fab_height"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/activity_horizontal_margin"
        android:layout_marginBottom="@dimen/fab_bottom_offset"
        android:text="@string/ticket_activation_confirm"
        app:icon="@drawable/ic_check_24px"
        app:marginWindowInsets="all" />
</cz.spojenka.android.ui.helpers.CoordinatorLayoutFix>