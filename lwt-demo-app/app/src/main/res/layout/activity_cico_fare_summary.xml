<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/activity_horizontal_margin"
    app:paddingWindowInsets="horizontal">

    <cz.spojenka.lwt.demoapp.TitleBar
        android:id="@+id/tbTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/activity_vertical_margin"
        android:layout_marginBottom="@dimen/section_margin_normal"
        android:text="@string/cico_fare_summary_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:marginWindowInsets="top" />

    <com.google.android.material.divider.MaterialDivider
        android:id="@+id/filler"
        android:layout_marginVertical="@dimen/section_margin_normal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/tvPriceLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/cico_fare_summary_price_label"
        android:textAlignment="textEnd"
        android:paddingHorizontal="@dimen/activity_horizontal_margin" />

    <TextView
        android:id="@+id/tvPrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:text="123 CZK"
        android:textAlignment="textEnd"
        android:textSize="@dimen/text_title_l"
        android:paddingBottom="@dimen/activity_vertical_margin"
        android:paddingHorizontal="@dimen/activity_horizontal_margin"
        app:marginWindowInsets="bottom" />

</LinearLayout>