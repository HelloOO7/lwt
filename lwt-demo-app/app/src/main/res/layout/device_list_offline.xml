<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="@dimen/item_margin_normal"
    android:paddingHorizontal="@dimen/section_margin_normal"
    app:marginWindowInsets="horizontal"
    android:background="?android:attr/selectableItemBackground">

    <ImageView
        android:id="@+id/ivOfflineIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_sensors_off_24px"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/tvOfflineText"
        app:layout_constraintBottom_toBottomOf="@+id/tvOfflineText"
        app:layout_constraintTop_toTopOf="@id/tvOfflineText"
        app:layout_constraintHorizontal_chainStyle="packed" />

    <TextView
        android:id="@+id/tvOfflineText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/item_margin_normal"
        app:layout_constrainedWidth="true"
        android:text="@string/device_list_offline_need_perms"
        app:layout_constraintStart_toEndOf="@id/ivOfflineIcon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>